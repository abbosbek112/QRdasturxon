# --- Lokalda ishlash uchun ---
# DEBUG=true bo'lsa kalit tekshiruvi o'tkazib yuboriladi va HTTPS talab qilinmaydi
DEBUG=true
SECRET_KEY=dev-insecure-secret-change-me
DATABASE_URL=sqlite:///./qrdasturxon.db
BASE_URL=http://localhost:8000
MEDIA_DIR=media


# --- Serverda (docker compose) ---
# Quyidagilarni to'ldiring va DEBUG'ni olib tashlang yoki false qiling.
#
# Kalitni shu buyruq bilan yarating (32 belgidan qisqa bo'lsa server ko'tarilmaydi):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# DEBUG=false
# SECRET_KEY=<yuqoridagi buyruq bergan qiymat>
# BASE_URL=https://menu.sizningdomen.uz
# DOMAIN=menu.sizningdomen.uz
# POSTGRES_DB=qrdasturxon
# POSTGRES_USER=qrdasturxon
# POSTGRES_PASSWORD=<uzun tasodifiy parol>


# --- Afitsant bildirishnomasi (ixtiyoriy) ---
# Busiz hamma narsa ishlayveradi, faqat afitsant telefoni cho'ntakda
# bo'lganda yangi buyurtma haqida xabar kelmaydi.
#
# Kalitlarni SERVERDA bir marta yarating va natijani shu yerga ko'chiring:
#   python -m scripts.vapid_keys
#
# Maxfiy kalit hech qachon repoga tushmasin. Uni almashtirsangiz mavjud
# obunalar kuchini yo'qotadi — afitsantlar bildirishnomani qayta yoqadi.
#
# VAPID_PUBLIC_KEY=<yuqoridagi buyruq bergan ochiq kalit>
# VAPID_PRIVATE_KEY=<yuqoridagi buyruq bergan maxfiy kalit>
# VAPID_SUBJECT=mailto:siz@example.com


# --- Afitsant ilovasi ---
# Ikkalasi ham do'kon ro'yxatisiz tarqatiladi.
#
# Android: `eas build` bergan APK ni app/static/app/qrdasturxon-zal.apk ga
# qo'ying — u /ilova sahifasida o'zi paydo bo'ladi.
#
# iPhone: TestFlight havolasini shu yerga yozing. Bo'sh qolsa sahifa
# iPhone egasiga PWA yo'riqnomasini ko'rsatadi.
#
# APP_VERSION ilovadagi versiya bilan bir xil bo'lsin — ilova yangilanish
# borligini shundan biladi.
# APP_VERSION=1.0.0
# TESTFLIGHT_URL=https://testflight.apple.com/join/xxxxxxxx
