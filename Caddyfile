{$DOMAIN} {
	reverse_proxy app:8000

	# Rasmlar va CSS/JS o'zgarmaydi (nomida versiya bor) — uzoq keshlansin
	@static path /static/* /media/*
	header @static Cache-Control "public, max-age=2592000"

	encode gzip zstd

	log {
		output stdout
		format console
	}
}

# www bo'lsa asosiy domenga o'tkazamiz — menyu ikki xil manzilda ochilmasin,
# aks holda QR kod bir manzilga, havolalar boshqasiga ishora qiladi.
# DOMAIN o'rniga port berilgan bo'lsa (lokal sinov) bu blok chetlab o'tiladi.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
